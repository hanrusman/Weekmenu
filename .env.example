# Bearer token used by Home Assistant sensor to read /api/today.
# Generate: openssl rand -base64 48
HA_API_TOKEN=

# Who may embed the app in an iframe. Default 'self' (same-origin only).
# To allow Home Assistant: FRAME_ANCESTORS="'self' https://ha.example.com"
#FRAME_ANCESTORS='self'

# SameSite attribute of the session cookie: lax (default), strict, or none.
# Set to "none" so login works inside a cross-site iframe (e.g. Home Assistant).
# "none" forces the Secure flag, so it requires HTTPS.
#COOKIE_SAMESITE=lax

# The shared LiteLLM proxy (OpenAI-compatible) for free-text recipe import, the
# vegetable top-up and menu proposals. Without these two recipes are entered by
# hand and the menu is picked without a proposal.
#LITELLM_URL=http://litellm:4000
#LITELLM_API_KEY=
# Model alias used to read recipes (default cloud-gemma)
#RECIPE_PARSE_MODEL=cloud-gemma
# Model alias that proposes a week in the menu picker, and the one for its last try
#MENU_MODEL=cloud-glm
#MENU_FALLBACK_MODEL=cloud-kimi
# The assistant for one day in the picker: someone waits for it, so a quick model
#MENU_CHAT_MODEL=cloud-gemma
#MENU_CHAT_FALLBACK_MODEL=cloud-mistral

# Recipe pictures: token for the script that makes them on a Mac
# (scripts/generate-recipe-images.ts). Without it the upload API is off.
#IMAGE_WORKER_TOKEN=
